# Copy to .env.local for local development. Set the real values as GitHub
# Actions *variables* for CI/deploy (see .github/workflows/deploy-pages.yml).
# These are NEXT_PUBLIC_*, so they are inlined into the client bundle and are
# public once the site ships — do not put anything genuinely secret here.

# Power Automate / Logic App HTTP trigger in the Fabric Belgium Microsoft
# tenant. The flow's only job is to email the submission to
# team@fabricbelgium.be through Outlook. Copy the full trigger URL including
# its query string. Leave blank and the contact form falls back to opening the
# visitor's own mail client, so enquiries are never silently lost.
# Setup steps, including the CORS headers the flow must return:
#   docs/contact-form-flow.md
NEXT_PUBLIC_CONTACT_ENDPOINT=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
