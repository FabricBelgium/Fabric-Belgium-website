# Copy to .env.local for local development. Set the real values as GitHub
# Actions secrets for CI/deploy (see .github/workflows/azure-swa-deploy.yml).

# Contact / partnership form submission. Leave both blank to use the Azure
# Function fallback (api/) instead of HubSpot.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_CONTACT_FORM_ID=

NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Contact form endpoint used by ContactForm when HubSpot is not configured.
# Defaults to /api/contact-submission (the Azure Function fallback).
NEXT_PUBLIC_CONTACT_ENDPOINT=
