# Copy to .env.local for local development. Set the real values as GitHub
# Actions *variables* for CI/deploy (see .github/workflows/deploy-pages.yml).
# These are NEXT_PUBLIC_*, so they are inlined into the client bundle and are
# public once the site ships — do not put anything genuinely secret here.

# Share link of the Microsoft Form that feeds the contact flow. A Power Automate
# flow on the free Microsoft 365 seeded licence emails each response to
# team@fabricbelgium.be. Setup steps: docs/contact-form-flow.md
#
# Leave blank and the contact form falls back to opening the visitor's own mail
# client, so enquiries are never silently lost.
NEXT_PUBLIC_CONTACT_FORM_URL=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
